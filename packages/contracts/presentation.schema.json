{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4slides.local/schemas/presentation-1.0.0.json",
  "title": "AIAutoSlides Presentation IR",
  "type": "object",
  "required": ["schema_version", "meta", "source_ir", "slides"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "deck_id": {"type": "string", "minLength": 1},
    "meta": {"type": "object", "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1}, "audience": {"type": ["string", "object"]}, "goal": {"type": "string"}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}, "aspect_ratio": {"const": "16:9"}, "theme": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": true},
    "source_ir": {"$ref": "#/$defs/sourceIR"},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "slides": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slide"}},
    "design_tokens": {"type": "object"},
    "outputs": {"type": "object"}
  },
  "$defs": {
    "source": {
      "type": "object", "required": ["source_id", "type", "verification_status"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"}, "type": {"type": "string", "minLength": 1},
        "uri": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "locator": {"type": ["string", "null"]}, "verification_status": {"enum": ["verified", "unverified", "pending", "contradicted"]},
        "claims": {"type": "array"}, "assets": {"type": "array"}
      }, "additionalProperties": true
    },
    "sourceIR": {"type": "object", "required": ["schema_version", "sources"], "properties": {"schema_version": {"const": "1.0.0"}, "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["evidence_id", "source_id", "excerpt", "verification_status"], "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"}, "excerpt": {"type": "string", "minLength": 1}, "locator": {"type": ["string", "null"]}, "verification_status": {"enum": ["verified", "unverified", "pending", "contradicted"]}, "reviewer": {"type": ["string", "null"]}, "reviewed_at": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": true},
    "claim": {"type": "object", "required": ["claim_id", "statement", "evidence_ids", "review_status"], "properties": {"claim_id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "review_status": {"enum": ["pending", "verified", "contradicted"]}, "reviewer": {"type": ["string", "null"]}, "reviewed_at": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": true},
    "asset": {
      "type": "object", "required": ["asset_id", "media_type", "rights_status"],
      "properties": {"asset_id": {"$ref": "#/$defs/id"}, "uri": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}, "media_type": {"type": "string"}, "source_id": {"$ref": "#/$defs/id"}, "license": {"type": ["string", "null"]}, "rights_status": {"enum": ["approved", "pending", "restricted", "unknown"]}},
      "additionalProperties": true
    },
    "slide": {
      "type": "object", "required": ["slide_id", "type", "title", "evidence_ids", "elements"],
      "properties": {
        "slide_id": {"$ref": "#/$defs/id"}, "type": {"type": "string", "minLength": 1}, "role": {"type": "string"},
        "title": {"type": "string", "minLength": 1}, "assertion_title": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "asset_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "speaker_notes": {"type": "string"}, "time_budget_seconds": {"type": "number", "exclusiveMinimum": 0},
        "design": {"type": "object"}, "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}}
      }, "additionalProperties": true
    },
    "element": {
      "type": "object", "required": ["element_id", "kind"],
      "properties": {
        "element_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["text", "bullets", "table", "cards", "callout", "image", "chart", "mermaid", "process", "diagram"]},
        "source_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "transform": {"type": ["string", "object", "null"]},
        "text": {"type": "string"}, "value": {}, "asset_id": {"$ref": "#/$defs/id"}, "alt": {"type": "string", "minLength": 1}, "x": {"type": "number", "minimum": 0, "maximum": 13.333}, "y": {"type": "number", "minimum": 0, "maximum": 7.5}, "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 13.333}, "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 7.5}, "items": {"type": "array"}, "headers": {"type": "array", "items": {"type": "string"}}, "rows": {"type": "array", "items": {"type": "array"}},
        "steps": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1}, "detail": {"type": "string"}}, "additionalProperties": true}]}}, "groups": {"type": "array", "items": {"type": "object", "required": ["label", "x", "y", "w", "h"], "properties": {"label": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "w": {"type": "number", "exclusiveMinimum": 0}, "h": {"type": "number", "exclusiveMinimum": 0}}}}, "nodes": {"type": "array", "items": {"type": "object", "required": ["id", "label", "x", "y", "w", "h"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "w": {"type": "number", "exclusiveMinimum": 0}, "h": {"type": "number", "exclusiveMinimum": 0}}}}, "edges": {"type": "array", "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "label": {"type": "string"}}}}, "chart_kind": {"enum": ["bar", "line", "scatter", "cdf"]}, "x_values": {"type": "array", "minItems": 2, "items": {"type": "number"}}, "categories": {"type": "array", "items": {"type": "string"}},
        "x_axis_label": {"type": "string"}, "y_axis_label": {"type": "string"}, "series": {"type": "array"}, "source": {"type": "string"}, "asset_rights": {"type": ["object", "null"]}
      }, "additionalProperties": true
    },
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 1}
  },
  "additionalProperties": false
}
